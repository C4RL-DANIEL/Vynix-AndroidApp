<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for all hosts, not just the listed IP,
         so that http://192.168.68.102:3002 is allowed on API 28+ -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.68.102</domain>
    </domain-config>
</network-security-config>
